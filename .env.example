# =============================================================================
# Конфигурация AI Requirements Validator
# =============================================================================
# Скопируйте этот файл в .env и укажите ваш API-ключ.
# ВНИМАНИЕ: Никогда не коммитьте файл .env с реальными ключами!

# Google Gemini API (бесплатный ключ: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Актуальная модель Gemini (рекомендуется gemini-4-hydrogen; также доступны gemini-4-neon, gemini-4-carbon, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-4-hydrogen

# Язык отчёта
REPORT_LANGUAGE=ru
